# Copy to .env (repo root) and fill in. .env is git-ignored; never commit real keys.

# ---------------------------------------------------------------------------
# PostgreSQL. docker-compose.yml creates the database from these values.
# Two naming schemes exist in the code base, so both point at the same database.
# POSTGRES_PORT / DB_PORT = host port published by docker-compose.
# ---------------------------------------------------------------------------
POSTGRES_USER=kkb_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kkb_db
POSTGRES_PORT=5435

DB_HOST=localhost
DB_PORT=5435
DB_NAME=kkb_db
DB_USER=kkb_user
DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Hosted LLM (any OpenAI-compatible endpoint).
# Used by the TTSG agent and the news sentiment pipeline.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_BASE=https://mia.csp.kloudeks.com/v1
OPENAI_MODEL=gpt-oss-120b

# ---------------------------------------------------------------------------
# Tender-ban pipeline (procurement_bans/pipeline.py): same endpoint, different names.
# When the pipeline runs in Docker, put these three lines in procurement_bans/.env
# (that folder is mounted as /workspace in the container).
# ---------------------------------------------------------------------------
API_KEY=
BASE_URL=https://mia.csp.kloudeks.com/v1
MODEL=gpt-oss-120b

# ---------------------------------------------------------------------------
# Trade Registry portal login (ticaretsicil.gov.tr) for the TTSG scraper
# ---------------------------------------------------------------------------
EMAIL=
PASSWORD=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# News API (currentsapi.services). Without it, news search uses DuckDuckGo only.
CURRENTS_API_KEY=
# Where the local Ollama server runs (MiniCPM-V for CAPTCHAs, Qwen2.5 prototype)
# OLLAMA_HOST=http://127.0.0.1:11434
# Windows only, if Tesseract is not in the default location
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
GAZETTE_DIR=scrapped_pdf_files
OUTPUT_DIR=OCR_outputs
